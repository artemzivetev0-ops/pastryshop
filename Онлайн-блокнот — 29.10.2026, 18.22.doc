<body><div style="font-family:Calibri,sans-serif;font-size:11pt;"><p><br>import React, { useState, useMemo, useEffect } from 'react';<br>import {&nbsp;<br>&nbsp; ShoppingBag, Heart, Search, Filter, Plus, Trash2, Edit3, X, Check, Star,&nbsp;<br>&nbsp; ChevronRight, ArrowLeft, Package, Sparkles, ShieldCheck, Truck, Phone,&nbsp;<br>&nbsp; Mail, MapPin, Menu, Eye, CheckCircle2, SlidersHorizontal, RefreshCw,<br>&nbsp; Tag, Percent, CreditCard, Clock, Award<br>} from 'lucide-react';</p><p>// Preset photos for seller upload convenience<br>const IMAGE_PRESETS = [<br>&nbsp; { name: 'Насадка «Открытая звезда»', url: 'https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?auto=format&amp;fit=crop&amp;w=600&amp;q=80' },<br>&nbsp; { name: 'Набор цветов «Восточная Роза»', url: 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&amp;fit=crop&amp;w=600&amp;q=80' },<br>&nbsp; { name: 'Одноразовые кондитерские мешки', url: 'https://images.unsplash.com/photo-1535141192574-5d4897c13136?auto=format&amp;fit=crop&amp;w=600&amp;q=80' },<br>&nbsp; { name: 'Силиконовые мешки и насадки', url: 'https://images.unsplash.com/photo-1621236378699-8597faf6a176?auto=format&amp;fit=crop&amp;w=600&amp;q=80' },<br>&nbsp; { name: 'Профессиональный набор кондитера', url: 'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&amp;fit=crop&amp;w=600&amp;q=80' },<br>&nbsp; { name: 'Капкейки с кремовым деформированием', url: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&amp;fit=crop&amp;w=600&amp;q=80' }<br>];</p><p>// Rich realistic pre-loaded pastry products<br>const INITIAL_PRODUCTS = [<br>&nbsp; {<br>&nbsp; &nbsp; id: 1,<br>&nbsp; &nbsp; title: 'Насадка №1M «Открытая звезда» (Wilton style)',<br>&nbsp; &nbsp; category: 'nozzles',<br>&nbsp; &nbsp; price: 340,<br>&nbsp; &nbsp; oldPrice: 420,<br>&nbsp; &nbsp; rating: 4.9,<br>&nbsp; &nbsp; reviewsCount: 142,<br>&nbsp; &nbsp; badge: 'Хит',<br>&nbsp; &nbsp; material: 'Нержавеющая сталь',<br>&nbsp; &nbsp; diameter: '18 мм',<br>&nbsp; &nbsp; inStock: 50,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Легендарная бесшовная насадка для формования эффектных шапочек на капкейках, бордюров для торта и воздушного зефира.',<br>&nbsp; &nbsp; creamCompatibility: ['Крем-чиз', 'Швейцарская меренга', 'Заварной крем', 'Зефирная масса']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 2,<br>&nbsp; &nbsp; title: 'Насадка №2D «Закрытая роза &amp; Пышный бутон»',<br>&nbsp; &nbsp; category: 'nozzles',<br>&nbsp; &nbsp; price: 360,<br>&nbsp; &nbsp; oldPrice: 450,<br>&nbsp; &nbsp; rating: 4.8,<br>&nbsp; &nbsp; reviewsCount: 98,<br>&nbsp; &nbsp; badge: null,<br>&nbsp; &nbsp; material: 'Нержавеющая сталь',<br>&nbsp; &nbsp; diameter: '19 мм',<br>&nbsp; &nbsp; inStock: 35,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Глубокие лепестковые зубцы формируют плотную и объемную розетку из крема за одно нажатие.',<br>&nbsp; &nbsp; creamCompatibility: ['Масляный крем', 'Ганаш', 'Крем-чиз на масле']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 3,<br>&nbsp; &nbsp; title: 'Набор насадок «Королевская флористика» (24 насадки + 2 адаптера)',<br>&nbsp; &nbsp; category: 'sets',<br>&nbsp; &nbsp; price: 2890,<br>&nbsp; &nbsp; oldPrice: 3500,<br>&nbsp; &nbsp; rating: 5.0,<br>&nbsp; &nbsp; reviewsCount: 64,<br>&nbsp; &nbsp; badge: 'Хит',<br>&nbsp; &nbsp; material: 'Нержавеющая сталь пищевая 304',<br>&nbsp; &nbsp; diameter: 'Разные размеры (от 12 до 25 мм)',<br>&nbsp; &nbsp; inStock: 15,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Профессиональный сет в органайзере: розы, тюльпаны, хризантемы, листики и сферы. Позволяет делать сложные кремовые композиции.',<br>&nbsp; &nbsp; creamCompatibility: ['Все виды кремов для цветов', 'Белково-заварной крем']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 4,<br>&nbsp; &nbsp; title: 'Одноразовые кондитерские мешки Extra-Grip 40 см (50 шт)',<br>&nbsp; &nbsp; category: 'bags',<br>&nbsp; &nbsp; price: 520,<br>&nbsp; &nbsp; oldPrice: 650,<br>&nbsp; &nbsp; rating: 4.9,<br>&nbsp; &nbsp; reviewsCount: 230,<br>&nbsp; &nbsp; badge: 'Скидка',<br>&nbsp; &nbsp; material: 'ПНД повышенной прочности',<br>&nbsp; &nbsp; thickness: '90 мкм',<br>&nbsp; &nbsp; inStock: 140,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1535141192574-5d4897c13136?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Шероховатая внешняя поверхность препятствует скольжению в ладони. Не рвутся даже при работе с плотным зефиром или густым ганашем.',<br>&nbsp; &nbsp; creamCompatibility: ['Густой зефир', 'Тесто для профитролей', 'Ганаш']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 5,<br>&nbsp; &nbsp; title: 'Многоразовый силиконовый мешок Platinum 35 см + фиксатор',<br>&nbsp; &nbsp; category: 'bags',<br>&nbsp; &nbsp; price: 690,<br>&nbsp; &nbsp; oldPrice: null,<br>&nbsp; &nbsp; rating: 4.7,</p><p>Сынок (17:23):<br>reviewsCount: 71,<br>&nbsp; &nbsp; badge: 'Новинка',<br>&nbsp; &nbsp; material: 'Пищевой силикон',<br>&nbsp; &nbsp; thickness: 'Эластичный 1.5 мм',<br>&nbsp; &nbsp; inStock: 40,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1621236378699-8597faf6a176?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Экологичная замена одноразовым мешкам. Легко моется, выдерживает температуру от -40°C до +220°C.',<br>&nbsp; &nbsp; creamCompatibility: ['Теплый шоколад', 'Сливки', 'Крем-чиз']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 6,<br>&nbsp; &nbsp; title: 'Насадка «Восточный Тюльпан» 3D (3 шт)',<br>&nbsp; &nbsp; category: 'nozzles',<br>&nbsp; &nbsp; price: 890,<br>&nbsp; &nbsp; oldPrice: 1100,<br>&nbsp; &nbsp; rating: 4.8,<br>&nbsp; &nbsp; reviewsCount: 52,<br>&nbsp; &nbsp; badge: null,<br>&nbsp; &nbsp; material: 'Нержавеющая сталь',<br>&nbsp; &nbsp; diameter: '23 мм',<br>&nbsp; &nbsp; inStock: 25,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Выдавливает готовый бутон тюльпана с тычинками за один раз. Требует плотной структуры крема.',<br>&nbsp; &nbsp; creamCompatibility: ['Белково-заварной (БЗК)', 'Плотный масляный крем']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 7,<br>&nbsp; &nbsp; title: 'Кондитерские мешки из хлопкового полотна с ламинацией (2 шт)',<br>&nbsp; &nbsp; category: 'bags',<br>&nbsp; &nbsp; price: 780,<br>&nbsp; &nbsp; oldPrice: 900,<br>&nbsp; &nbsp; rating: 4.6,<br>&nbsp; &nbsp; reviewsCount: 38,<br>&nbsp; &nbsp; badge: null,<br>&nbsp; &nbsp; material: 'Многоразовый хлопок',<br>&nbsp; &nbsp; thickness: 'Двойной слой',<br>&nbsp; &nbsp; inStock: 18,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1535141192574-5d4897c13136?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Прочные хлопковые мешки с внутренним защитным слоем из пищевого полиуретана. Не растягиваются при высоком давлении.',<br>&nbsp; &nbsp; creamCompatibility: ['Плотное тесто для экалеров', 'Заварной крем']<br>&nbsp; },<br>&nbsp; {<br>&nbsp; &nbsp; id: 8,<br>&nbsp; &nbsp; title: 'Насадка «Сфера Бал» №3D для объемного крема',<br>&nbsp; &nbsp; category: 'nozzles',<br>&nbsp; &nbsp; price: 450,<br>&nbsp; &nbsp; oldPrice: 550,<br>&nbsp; &nbsp; rating: 4.9,<br>&nbsp; &nbsp; reviewsCount: 88,<br>&nbsp; &nbsp; badge: 'Хит',<br>&nbsp; &nbsp; material: 'Нержавеющая сталь',<br>&nbsp; &nbsp; diameter: '25 мм',<br>&nbsp; &nbsp; inStock: 30,<br>&nbsp; &nbsp; image: 'https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?auto=format&amp;fit=crop&amp;w=600&amp;q=80',<br>&nbsp; &nbsp; description: 'Сферическая насадка с фигурными прорезями создает пышные гофрированные шары из крема.',<br>&nbsp; &nbsp; creamCompatibility: ['Взбитые сливки', 'Меренга', 'Крем-чиз']<br>&nbsp; }<br>];</p><p>export default function App() {<br>&nbsp; // State<br>&nbsp; const [products, setProducts] = useState(() =&gt; {<br>&nbsp; &nbsp; const saved = localStorage.getItem('sweetcraft_products_v2');<br>&nbsp; &nbsp; return saved ? JSON.parse(saved) : INITIAL_PRODUCTS;<br>&nbsp; });<br>&nbsp; const [cart, setCart] = useState([]);<br>&nbsp; const [wishlist, setWishlist] = useState([]);<br>&nbsp; const [selectedCategory, setSelectedCategory] = useState('all');<br>&nbsp; const [selectedMaterial, setSelectedMaterial] = useState('all');<br>&nbsp; const [sortBy, setSortBy] = useState('popular');<br>&nbsp; const [searchQuery, setSearchQuery] = useState('');<br>&nbsp; const [priceRange, setPriceRange] = useState(5000);<br>&nbsp;&nbsp;<br>&nbsp; // Modals &amp; Drawers<br>&nbsp; const [isCartOpen, setIsCartOpen] = useState(false);<br>&nbsp; const [isWishlistOpen, setIsWishlistOpen] = useState(false);<br>&nbsp; const [quickViewProduct, setQuickViewProduct] = useState(null);<br>&nbsp; const [isAdminOpen, setIsAdminOpen] = useState(false);<br>&nbsp; const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);<br>&nbsp; const [editingProduct, setEditingProduct] = useState(null);</p><p>&nbsp; // Promo Code State<br>&nbsp; const [promoCode, setPromoCode] = useState('');<br>&nbsp; const [appliedDiscount, setAppliedDiscount] = useState(0);<br>&nbsp; const [promoError, setPromoError] = useState('');</p><p>&nbsp; // Toast<br>&nbsp; const [toast, setToast] = useState(null);<br>&nbsp; const showToast = (msg) =&gt; {<br>&nbsp; &nbsp; setToast(msg);<br>&nbsp; &nbsp; setTimeout(() =&gt; setToast(null), 3000);<br>&nbsp; };</p><p>&nbsp; // Seller/Admin Form State<br>&nbsp; const [productForm, setProductForm] = useState({<br>&nbsp; &nbsp; title: '',<br>&nbsp; &nbsp; category: 'nozzles',<br>&nbsp; &nbsp; price: '',<br>&nbsp; &nbsp; oldPrice: '',<br>&nbsp; &nbsp; material: 'Нержавеющая сталь',<br>&nbsp; &nbsp; description: '',<br>&nbsp; &nbsp; image: IMAGE_PRESETS[0].url,<br>&nbsp; &nbsp; inStock: 25,<br>&nbsp; &nbsp; badge: 'Новинка'<br>&nbsp; });</p><p>&nbsp; // Checkout State<br>&nbsp; const [orderPlaced, setOrderPlaced] = useState(false);<br>&nbsp; const [checkoutData, setCheckoutData] = useState({<br>&nbsp; &nbsp; name: '',<br>&nbsp; &nbsp; phone: '',<br>&nbsp; &nbsp; city: 'Москва',<br>&nbsp; &nbsp; address: '',<br>&nbsp; &nbsp; deliveryMethod: 'cdek',</p><p>Сынок (17:23):<br>paymentMethod: 'card'<br>&nbsp; });</p><p>&nbsp; // Save Products to LocalStorage<br>&nbsp; useEffect(() =&gt; {<br>&nbsp; &nbsp; localStorage.setItem('sweetcraft_products_v2', JSON.stringify(products));<br>&nbsp; }, [products]);</p><p>&nbsp; // Filtered &amp; Sorted Products<br>&nbsp; const filteredProducts = useMemo(() =&gt; {<br>&nbsp; &nbsp; let result = products.filter(p =&gt; {<br>&nbsp; &nbsp; &nbsp; const matchesCategory = selectedCategory === 'all' || p.category === selectedCategory;<br>&nbsp; &nbsp; &nbsp; const matchesMaterial = selectedMaterial === 'all' || p.material.toLowerCase().includes(selectedMaterial.toLowerCase());<br>&nbsp; &nbsp; &nbsp; const matchesSearch = p.title.toLowerCase().includes(searchQuery.toLowerCase()) ||&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; p.description.toLowerCase().includes(searchQuery.toLowerCase());<br>&nbsp; &nbsp; &nbsp; const matchesPrice = p.price &lt;= priceRange;<br>&nbsp; &nbsp; &nbsp; return matchesCategory &amp;&amp; matchesMaterial &amp;&amp; matchesSearch &amp;&amp; matchesPrice;<br>&nbsp; &nbsp; });</p><p>&nbsp; &nbsp; // Sorting<br>&nbsp; &nbsp; if (sortBy === 'price-asc') {<br>&nbsp; &nbsp; &nbsp; result.sort((a, b) =&gt; a.price - b.price);<br>&nbsp; &nbsp; } else if (sortBy === 'price-desc') {<br>&nbsp; &nbsp; &nbsp; result.sort((a, b) =&gt; b.price - a.price);<br>&nbsp; &nbsp; } else if (sortBy === 'rating') {<br>&nbsp; &nbsp; &nbsp; result.sort((a, b) =&gt; b.rating - a.rating);<br>&nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; // Popular (by reviews count)<br>&nbsp; &nbsp; &nbsp; result.sort((a, b) =&gt; b.reviewsCount - a.reviewsCount);<br>&nbsp; &nbsp; }</p><p>&nbsp; &nbsp; return result;<br>&nbsp; }, [products, selectedCategory, selectedMaterial, searchQuery, priceRange, sortBy]);</p><p>&nbsp; // Cart Management<br>&nbsp; const addToCart = (product, qty = 1) =&gt; {<br>&nbsp; &nbsp; setCart(prev =&gt; {<br>&nbsp; &nbsp; &nbsp; const existing = prev.find(item =&gt; item.id === product.id);<br>&nbsp; &nbsp; &nbsp; if (existing) {<br>&nbsp; &nbsp; &nbsp; &nbsp; return prev.map(item =&gt; item.id === product.id ? { ...item, quantity: item.quantity + qty } : item);<br>&nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; &nbsp; return [...prev, { ...product, quantity: qty }];<br>&nbsp; &nbsp; });<br>&nbsp; &nbsp; showToast(`Товар "${product.title.slice(0, 22)}..." добавлен в корзину`);<br>&nbsp; };</p><p>&nbsp; const updateCartQuantity = (id, delta) =&gt; {<br>&nbsp; &nbsp; setCart(prev =&gt; prev.map(item =&gt; {<br>&nbsp; &nbsp; &nbsp; if (item.id === id) {<br>&nbsp; &nbsp; &nbsp; &nbsp; const newQty = item.quantity + delta;<br>&nbsp; &nbsp; &nbsp; &nbsp; return newQty &gt; 0 ? { ...item, quantity: newQty } : item;<br>&nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; &nbsp; return item;<br>&nbsp; &nbsp; }));<br>&nbsp; };</p><p>&nbsp; const removeFromCart = (id) =&gt; {<br>&nbsp; &nbsp; setCart(prev =&gt; prev.filter(item =&gt; item.id !== id));<br>&nbsp; };</p><p>&nbsp; const rawCartTotal = useMemo(() =&gt; {<br>&nbsp; &nbsp; return cart.reduce((sum, item) =&gt; sum + item.price * item.quantity, 0);<br>&nbsp; }, [cart]);</p><p>&nbsp; const discountAmount = useMemo(() =&gt; {<br>&nbsp; &nbsp; return Math.round(rawCartTotal * appliedDiscount);<br>&nbsp; }, [rawCartTotal, appliedDiscount]);</p><p>&nbsp; const deliveryCost = useMemo(() =&gt; {<br>&nbsp; &nbsp; if (rawCartTotal &gt;= 3000 || rawCartTotal === 0) return 0;<br>&nbsp; &nbsp; return checkoutData.deliveryMethod === 'courier' ? 450 : 300;<br>&nbsp; }, [rawCartTotal, checkoutData.deliveryMethod]);</p><p>&nbsp; const finalCartTotal = useMemo(() =&gt; {<br>&nbsp; &nbsp; return Math.max(0, rawCartTotal - discountAmount) + deliveryCost;<br>&nbsp; }, [rawCartTotal, discountAmount, deliveryCost]);</p><p>&nbsp; // Promo Code Handler<br>&nbsp; const handleApplyPromo = (e) =&gt; {<br>&nbsp; &nbsp; e.preventDefault();<br>&nbsp; &nbsp; if (promoCode.trim().toUpperCase() === 'SWEET10') {<br>&nbsp; &nbsp; &nbsp; setAppliedDiscount(0.10);<br>&nbsp; &nbsp; &nbsp; setPromoError('');<br>&nbsp; &nbsp; &nbsp; showToast('Промокод SWEET10 применён! Скидка 10%');<br>&nbsp; &nbsp; } else if (promoCode.trim().toUpperCase() === 'VIP20') {<br>&nbsp; &nbsp; &nbsp; setAppliedDiscount(0.20);<br>&nbsp; &nbsp; &nbsp; setPromoError('');<br>&nbsp; &nbsp; &nbsp; showToast('VIP Промокод применён! Скидка 20%');<br>&nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; setPromoError('Неверный промокод (Попробуйте SWEET10)');<br>&nbsp; &nbsp; }<br>&nbsp; };</p><p>&nbsp; // Wishlist<br>&nbsp; const toggleWishlist = (product) =&gt; {<br>&nbsp; &nbsp; setWishlist(prev =&gt; {<br>&nbsp; &nbsp; &nbsp; const exists = prev.some(item =&gt; item.id === product.id);<br>&nbsp; &nbsp; &nbsp; if (exists) {<br>&nbsp; &nbsp; &nbsp; &nbsp; showToast('Удалено из избранного');<br>&nbsp; &nbsp; &nbsp; &nbsp; return prev.filter(item =&gt; item.id !== product.id);<br>&nbsp; &nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; &nbsp; showToast('Добавлено в избранное');<br>&nbsp; &nbsp; &nbsp; &nbsp; return [...prev, product];<br>&nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; });<br>&nbsp; };</p><p>&nbsp; // Admin / Seller Product Actions<br>&nbsp; const handleSaveProduct = (e) =&gt; {<br>&nbsp; &nbsp; e.preventDefault();<br>&nbsp; &nbsp; if (!productForm.title || !productForm.price) return;</p><p>&nbsp; &nbsp; const newProd = {<br>&nbsp; &nbsp; &nbsp; id: editingProduct ? editingProduct.id : Date.now(),<br>&nbsp; &nbsp; &nbsp; title: productForm.title,</p><p>Сынок (17:23):<br>category: productForm.category,<br>&nbsp; &nbsp; &nbsp; price: Number(productForm.price),<br>&nbsp; &nbsp; &nbsp; oldPrice: productForm.oldPrice ? Number(productForm.oldPrice) : null,<br>&nbsp; &nbsp; &nbsp; rating: editingProduct ? editingProduct.rating : 5.0,<br>&nbsp; &nbsp; &nbsp; reviewsCount: editingProduct ? editingProduct.reviewsCount : 1,<br>&nbsp; &nbsp; &nbsp; badge: productForm.badge || 'Новинка',<br>&nbsp; &nbsp; &nbsp; material: productForm.material,<br>&nbsp; &nbsp; &nbsp; inStock: Number(productForm.inStock || 20),<br>&nbsp; &nbsp; &nbsp; image: productForm.image || IMAGE_PRESETS[0].url,<br>&nbsp; &nbsp; &nbsp; description: productForm.description || 'Высококачественный кондитерский инструмент для кондитеров.',<br>&nbsp; &nbsp; &nbsp; creamCompatibility: ['Все виды кремов', 'Меренга', 'Ганаш']<br>&nbsp; &nbsp; };</p><p>&nbsp; &nbsp; if (editingProduct) {<br>&nbsp; &nbsp; &nbsp; setProducts(prev =&gt; prev.map(p =&gt; p.id === editingProduct.id ? newProd : p));<br>&nbsp; &nbsp; &nbsp; showToast('Товар успешно обновлен!');<br>&nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; setProducts(prev =&gt; [newProd, ...prev]);<br>&nbsp; &nbsp; &nbsp; showToast('Новый товар выставлен на продажу!');<br>&nbsp; &nbsp; }</p><p>&nbsp; &nbsp; setEditingProduct(null);<br>&nbsp; &nbsp; setProductForm({<br>&nbsp; &nbsp; &nbsp; title: '', category: 'nozzles', price: '', oldPrice: '',&nbsp;<br>&nbsp; &nbsp; &nbsp; material: 'Нержавеющая сталь', description: '', image: IMAGE_PRESETS[0].url, inStock: 25, badge: 'Новинка'<br>&nbsp; &nbsp; });<br>&nbsp; };</p><p>&nbsp; const handleDeleteProduct = (id) =&gt; {<br>&nbsp; &nbsp; setProducts(prev =&gt; prev.filter(p =&gt; p.id !== id));<br>&nbsp; &nbsp; showToast('Товар удален из каталога');<br>&nbsp; };</p><p>&nbsp; const startEditProduct = (product) =&gt; {<br>&nbsp; &nbsp; setEditingProduct(product);<br>&nbsp; &nbsp; setProductForm({<br>&nbsp; &nbsp; &nbsp; title: product.title,<br>&